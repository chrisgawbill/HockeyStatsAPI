# ---------------------------------------------------------------------------
# Backend (Express API) environment variables.
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# All values below are optional unless noted; defaults are shown where they apply.
# ---------------------------------------------------------------------------

# HTTP server
# Port the API listens on (see bin/www).
PORT=9000

# development | production
# In production, the AI subprocess uses system `python3` and DB SSL defaults on.
# In development, it uses `venv/bin/python3` when a local virtualenv is present.
NODE_ENV=development

# ---------------------------------------------------------------------------
# AI integration (team history endpoint, src/platform/hockey-ai.py)
# Required for /python-service to return data; without it the AI call fails.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Claude model for the AI endpoint. Required: hockey-ai.py has no in-code
# default, so if this is unset the AI call fails.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Diagnostics (/health, /health/cache-usage)
# Passphrase sent in the `x-diagnostics-key` header. The check fails closed when
# unset (diagnostics return 401). Use a high-entropy value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
DIAGNOSTICS_PASSPHRASE=

# ---------------------------------------------------------------------------
# Caching (raw NHL response cache -> app_cache table)
# With no CACHE_DATABASE_URL the app uses local cache folders.
# With it set, the app defaults to Postgres.
# ---------------------------------------------------------------------------
CACHE_DATABASE_URL=
# 'true' forces SSL, 'false' disables it. Default: on when NODE_ENV=production.
CACHE_DATABASE_SSL=
# Connection/query timeout for the cache pool (ms). Default 5000.
CACHE_DATABASE_TIMEOUT_MS=5000
# Override the storage mode: filesystem | postgres | hybrid.
# Default: postgres when CACHE_DATABASE_URL is set, otherwise filesystem.
CACHE_STORAGE=

# ---------------------------------------------------------------------------
# Normalized domain persistence (seasons/teams/players/... tables)
# Migrations run automatically on `pnpm start` (skipped when CACHE_DATABASE_URL
# is unset); `pnpm run db:migrate` runs them manually. Both read
# CACHE_DATABASE_URL above.
# Domain backfills use DATABASE_URL, falling back to CACHE_DATABASE_URL.
# ---------------------------------------------------------------------------
DATABASE_URL=
# Query timeout for the domain pool (ms). Default 5000.
DATABASE_TIMEOUT_MS=5000
# Set to 'true' to skip normalized-table backfills while keeping the raw cache.
DISABLE_DOMAIN_PERSISTENCE=

# CA certificate used to verify the Postgres server's TLS cert. REQUIRED
# whenever SSL is enabled (NODE_ENV=production or CACHE_DATABASE_SSL=true) —
# getSslConfig() throws without it (fail-closed) rather than skipping
# verification. Accepts either the PEM text itself (paste the full
# -----BEGIN CERTIFICATE-----...-----END CERTIFICATE----- block, e.g. in a
# Render env var) or a path to a .pem file on disk. Neon chains to Let's
# Encrypt's ISRG Root X1 (https://letsencrypt.org/certs/isrgrootx1.pem).
DATABASE_CA_CERT=

# ---------------------------------------------------------------------------
# Google Sign-In (site-wide account: /api/auth/*, /api/board-game/*,
# /api/favorites/*, /api/after-action-reports/*)
# Optional feature; without these two vars the signed-in routes fail closed
# (401/500) but the rest of the API is unaffected.
# ---------------------------------------------------------------------------
# OAuth 2.0 Client ID from Google Cloud Console (Identity Services). Must match
# the audience the frontend's Google Sign-In button was configured with.
GOOGLE_OAUTH_CLIENT_ID=
# Secret used to sign/verify the app's own 30-day session JWT issued after a
# successful Google or Discord sign-in (never the provider's token). Use a
# high-entropy value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_JWT_SECRET=
# Keys for stored user emails. EMAIL_ENCRYPTION_KEY encrypts them (AES-256-GCM);
# EMAIL_LOOKUP_KEY hashes them (HMAC-SHA256) so they can be looked up without
# decrypting. Each is 32 random bytes, base64-encoded:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back both up: losing EMAIL_ENCRYPTION_KEY makes stored emails unreadable, and
# changing EMAIL_LOOKUP_KEY breaks lookups of existing rows.
EMAIL_ENCRYPTION_KEY=
EMAIL_LOOKUP_KEY=

# ---------------------------------------------------------------------------
# Web Push for After Action Reports (/api/push/*)
# Push stays disabled (GET /api/push/config -> enabled:false) unless all three
# VAPID values are set. Generate a key pair once with:
#   npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
# Public VAPID key (also served to browsers by GET /api/push/config).
VAPID_PUBLIC_KEY=
# Private VAPID key. Keep secret.
VAPID_PRIVATE_KEY=
# Contact for push services, a mailto: or https: URL (e.g. mailto:you@example.com).
VAPID_SUBJECT=
# Shared secret the notifier's schedules send as `Authorization: Bearer ...` to
# POST /api/push/dispatch and /api/push/weekly-dispatch (503 when unset). Use a
# high-entropy value; the notifier config references the same value.
CRON_SECRET=
# Notifier service (notifier/README.md): when both are set, pushes are queued
# there and retried instead of being sent once from here. URL like
# http://127.0.0.1:9100; the token is this app's `token` in the notifier config.
NOTIFIER_URL=
NOTIFIER_TOKEN=
# Bearer secret the notifier sends to POST /api/push/notifier-events (its
# `events.token` for this app). That route returns 503 while it is unset.
NOTIFIER_CALLBACK_SECRET=
# Microsoft sign-in: Application (client) ID from the Entra ID app registration.
MICROSOFT_CLIENT_ID=
# Discord OAuth2 credentials from the Discord Developer Portal, used by
# POST /api/auth/discord. DISCORD_REDIRECT_URIS is a comma-separated list of the
# web app URLs Discord may send the user back to (no `#` fragment), e.g.
#   http://localhost:5173/HockeyStatsWebApp/,https://chrisgawbill.github.io/HockeyStatsWebApp/
# Every URI listed here must also be registered under OAuth2 -> Redirects.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URIS=
# Brevo transactional email. The sender address must be verified in Brevo;
# BREVO_SENDER_NAME is optional.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
